{
  "permissionMode": "default",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": []
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "just fix-lint"
          }
        ]
      }
    ]
  },
  "allowedTools": [
    "Bash(git status)",
    "Bash(git log*)",
    "Bash(git show*)",
    "Bash(git diff*)",
    "Bash(git branch*)",
    "Bash(git ls-files*)",
    "Bash(git ls-tree*)",
    "Bash(git rev-parse*)",
    "Bash(git rev-list*)",
    "Bash(git cat-file*)",
    "Bash(git ls-remote*)",
    "Bash(git remote*)",
    "Bash(git config --get*)",
    "Bash(git config --list)",
    "Bash(git tag*)",
    "Bash(git describe*)",
    "Bash(git reflog*)",
    "Bash(git blame*)",
    "Bash(git annotate*)",
    "Bash(git grep*)",
    "Bash(git shortlog*)",
    "Bash(git whatchanged*)",
    "Bash(git check-ref-format*)",
    "Bash(git symbolic-ref*)",
    "Bash(git name-rev*)",
    "Bash(git for-each-ref*)",
    "Bash(git verify-tag*)",
    "Bash(git verify-commit*)"
  ]
}
