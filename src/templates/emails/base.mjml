<mjml>
  <mj-head>
    <mj-title>{{ title }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.5" />
      <mj-button background-color="#4F46E5" color="#ffffff" border-radius="6px" />
    </mj-attributes>
    <mj-style>
      .footer-text { font-size: 12px; color: #666666; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f5">
    <!-- Header -->
    <mj-section background-color="#4F46E5" padding="20px">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="24px" font-weight="bold">
          Finance Categorizer
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Content Block -->
    {% block content %}{% endblock %}

    <!-- Footer -->
    <mj-section padding="20px">
      <mj-column>
        <mj-text align="center" css-class="footer-text">
          This is an automated message from Finance Categorizer.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
